Hinicial, Minicial, Hfinal, Mfinal = map (int, input().split())

if Hinicial == Hfinal:

    if Minicial == Mfinal:
        print(f'O JOGO DUROU 24 HORAS E 0 MINUTO(S) ')

    elif Minicial > Mfinal:
        print(f'O JOGO DUROU 24 HORAS E {(Minicial - Mfinal)} MINUTO(S) ')

    elif Minicial < Mfinal:
        print(f'O JOGO DUROU 24 HORAS E {(Mfinal - Minicial)} MINUTO(S) ')

elif Hinicial > Hfinal:

    if Minicial  == Mfinal:
        print(f'O JOGO DUROU {24 - (Hinicial-Hfinal)} HORA(S) E 0 MINUTO(S) ')

    elif Minicial > Mfinal:
        print(f'O JOGO DUROU {23 - (Hinicial - Hfinal)} HORA(S) E {60 - (Minicial - Mfinal)} MINUTOS')

    elif Minicial < Mfinal:
        print(f'O JOGO DUROU {24 - (Hinicial - Hfinal)} HORA(S) E {(Hinicial - Hfinal)} MINUTOS')

elif Hinicial < Hfinal:

    if Minicial  == Mfinal:
        print(f'O JOGO DUROU {(Hinicial-Hfinal)} HORA(S) E 0 MINUTO(S) ')

    elif Minicial > Mfinal:
        print(f'O JOGO DUROU {((Hinicial - Hfinal) - 1)} HORA(S) E {60 - (Minicial - Mfinal)} MINUTOS')

    elif Minicial < Mfinal:
        print(f'O JOGO DUROU {(Hfinal - Hinicial)} HORA(S) E {(Hfinal - Hinicial)} MINUTOS')
